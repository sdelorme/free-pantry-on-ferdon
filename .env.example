# Neon connection string, pooled endpoint.
# Grab it from the Neon dashboard → Connection Details → "Pooled connection".
# Leave this unset locally and the board renders seed data instead (see
# src/lib/seed.ts), so you can work on the design without a database.
DATABASE_URL=

# Shared password for the moderation queue at /admin.
# Not wired up yet — lands with layer 7.
ADMIN_PASSWORD=
