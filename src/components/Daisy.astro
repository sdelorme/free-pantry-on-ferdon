---
/**
 * One hand-painted daisy off the box: coloured petals, yellow centre.
 *
 * Four petals for the small card-corner mark, eight for the larger
 * decorative ones — the box has both.
 */
interface Props {
  color: string;
  size?: number;
  petals?: 4 | 8;
  class?: string;
}

const { color, size = 26, petals = 4, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <g fill={color}>
    <ellipse cx="50" cy="20" rx="11" ry="20" />
    <ellipse cx="50" cy="80" rx="11" ry="20" />
    <ellipse cx="20" cy="50" rx="20" ry="11" />
    <ellipse cx="80" cy="50" rx="20" ry="11" />
    {
      petals === 8 && (
        <>
          <ellipse cx="28" cy="28" rx="11" ry="20" transform="rotate(-45 28 28)" />
          <ellipse cx="72" cy="28" rx="11" ry="20" transform="rotate(45 72 28)" />
          <ellipse cx="28" cy="72" rx="11" ry="20" transform="rotate(45 28 72)" />
          <ellipse cx="72" cy="72" rx="11" ry="20" transform="rotate(-45 72 72)" />
        </>
      )
    }
  </g>
  <circle cx="50" cy="50" r="13" fill="#ffd63c" />
</svg>
